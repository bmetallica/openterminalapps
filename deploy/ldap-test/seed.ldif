# Ein kleines Verzeichnis, das aussieht wie ein echtes: Menschen unter
# ou=people, Gruppen unter ou=groups, ein Dienstkonto zum Anbinden.
#
# Der Eintrag `bmetallica` ist Absicht. Er trägt denselben Namen wie ein
# lokales Konto in OTA — und genau daran wird geprüft, dass ein
# Verzeichniseintrag ein bestehendes lokales Konto nicht übernehmen kann.

dn: ou=people,dc=ota,dc=test
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=ota,dc=test
objectClass: organizationalUnit
ou: groups

# Das Dienstkonto. Es darf lesen, mehr nicht.
dn: cn=ota-dienst,dc=ota,dc=test
objectClass: inetOrgPerson
cn: ota-dienst
sn: Dienstkonto
userPassword: dienst-geheim-2026

