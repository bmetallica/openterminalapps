# Statische Traefik-Konfiguration.
#
# Aus der Vorlage daneben erzeugt `make setup` (und jedes `make up`) die eigentliche
# `traefik.yml`. Handarbeit gehoert deshalb hierher und nicht in die erzeugte
# Datei: Die wird beim naechsten Lauf ueberschrieben.
#
# Warum der Umweg: Traefik liest seine statische Konfiguration aus **genau
# einer** Quelle. Sobald diese Datei existiert, ignoriert es Umgebungsvariablen
# und Kommandozeilenargumente vollstaendig — gemessen am 2026-08-29, als
# TRAEFIK_ENTRYPOINTS_..._TRUSTEDIPS wirkungslos blieb. Ein Wert, der je Anlage
# anders ist, muss also vor dem Start hier hineingeschrieben werden.
#
# Aenderungen erfordern einen Neustart von Traefik.

entryPoints:
  web:
    address: ":8080"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":8443"
    http:
      tls: {}
    # Wem wir glauben, wenn er sagt, unter welchem Namen der Browser uns sieht.
    #
    # Steht OTA hinter einem weiteren Reverse Proxy (hier Caddy unter
    # ota.boden.home), schickt der die urspruengliche Adresse in
    # X-Forwarded-Host mit. Traefik **ersetzt** solche Kopfzeilen aber, solange
    # der Absender nicht ausdruecklich als vertrauenswuerdig gilt — und dann
    # sieht Keycloak nur noch Traefik selbst.
    #
    # Die Folge war messbar und unangenehm: Wer ueber ota.boden.home kam, wurde
    # zur Anmeldung an https://192.168.66.224:8443 geschickt. Das ist eine
    # **andere Herkunft** — und genau daran haengt, dass die
    # Desktop-Verknuepfungen in ihrem Fenster bleiben (auth-roadmap.md §5.6).
    # Nebenbei stand die interne Adresse in der Adresszeile.
    #
    # Hier gehoert **nur** der eigene Reverse Proxy hinein. Wer hier steht,
    # darf behaupten, von wo eine Anfrage kommt — inklusive der Absender-IP,
    # die in Protokollen und Sperrlisten landet. Leer lassen, wenn OTA direkt
    # erreichbar ist.
    #
    # Gesetzt wird der Wert in `deploy/.env`:
    #
    #   OTA_TRUSTED_PROXIES=192.168.66.251/32
    #
    # Mehrere durch Komma getrennt. Leer heisst: niemandem glauben.
    #
    # **Die Adresse, unter der der Name aufloest, ist nicht unbedingt die, von
    # der die Anfrage kommt.** Hier loest ota.boden.home auf 192.168.66.1 auf,
    # der Proxy verbindet sich aber von 192.168.66.251. Nachsehen statt raten:
    #
    #   curl -sk https://<name>/api/gibtsnicht -o /dev/null
    #   docker logs ota-traefik --tail 5 | grep gibtsnicht
    #
    # Die erste Spalte ist der Absender.
@@FORWARDED_HEADERS@@
  # Dashboard. Der Name MUSS "traefik" lauten — an diesen Entrypoint bindet
  # sich api.insecure fest. Im Compose nur an 127.0.0.1 gebunden.
  traefik:
    address: ":8081"

providers:
  # Session-Container melden sich später selbst über Labels an.
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: ota_public
  # Zertifikate, Middlewares und alles, was nicht am Container hängt.
  file:
    directory: /etc/traefik/dynamic
    watch: true

# Achtung: Traefik liest die statische Konfiguration aus GENAU EINER Quelle.
# Sobald diese Datei existiert, werden CLI-Argumente vollständig ignoriert —
# sie werden nicht zusammengeführt. Alles Statische gehört deshalb hierher.
api:
  dashboard: true
  insecure: true

# Für den Healthcheck des Containers. Ohne diesen Abschnitt antwortet
# `traefik healthcheck --ping` nicht und der Container gilt dauerhaft als
# unhealthy — was Traefik zwar nicht stört, aber jede Überwachung falsch alarmiert.
ping:
  entryPoint: traefik

log:
  level: INFO

accessLog:
  filters:
    statusCodes:
      - "400-599"
