# Kopieren nach deploy/.env und anpassen.

# --- Netzwerk ---
# Solange Kasm auf 443 läuft, bleibt OTA auf 8443.
# Nach der Ablösung: 443 bzw. 80.
# 8080 ist auf diesem Host von searxng belegt, daher 8081.
OTA_HTTPS_PORT=8443
OTA_HTTP_PORT=8081

# --- Docker ---
# Docker 29 hat die API-Versionen unter 1.40 abgeschafft.
DOCKER_API_VERSION=1.44

# --- Datenbank ---
POSTGRES_DB=ota
POSTGRES_USER=ota
# PFLICHT. Erzeugen mit:  openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Version der gebauten Images ---
OTA_VERSION=dev

# --- Geheimnisse (PFLICHT) ---
# Erzeugen mit: openssl rand -base64 48 | tr -d '\n=+/' | head -c 64
OTA_JWT_SECRET=
OTA_AGENT_TOKEN=

# --- Kennzahlen (optional) ---
# Merkmal fuer einen Sammler wie Prometheus, der /metrics abfragt. Leer heisst:
# Nur angemeldete Administratoren kommen an /metrics. Absichtlich kein
# Standardwert — ein voreingestelltes Merkmal ist kein Merkmal.
OTA_METRICS_TOKEN=

# --- Ablage der Nutzerprofile ---
OTA_PROFILES_ROOT=/srv/ota/profiles
OTA_SKELETON_ROOT=/srv/ota/skeletons
OTA_BACKUP_ROOT=/srv/ota/backups
OTA_USERFILES_ROOT=/srv/ota/userfiles

# --- Identität (Keycloak) ---
#
# Zwei Betriebsarten, siehe auth-roadmap.md §5b:
#
#   mitgeliefert  Der Keycloak aus diesem Stack. Vorgabe. OTA legt den Realm
#                 an und ist darin führend.
#   vorhanden     Ein bereits betriebenes Keycloak. Dann muss der Realm
#                 existieren, und die dortige Verwaltung legt den Client
#                 `ota-manager` an und nennt uns sein Geheimnis. OTA ist dort
#                 Gast: Es löscht nichts und fasst nur die eigenen Gruppen an.
OTA_IDP_MODE=mitgeliefert

# Bei "vorhanden": die Adresse des fremden Keycloak, von der API aus erreichbar.
# Leer lassen, solange der mitgelieferte benutzt wird.
OTA_KEYCLOAK_URL=
OTA_KEYCLOAK_REALM=ota

# Ersteinrichtung des mitgelieferten Keycloak. Wird von scripts/setup-env.sh
# erzeugt. Dieses Konto richtet nur den Realm ein — danach arbeitet OTA über
# sein eigenes Dienstkonto.
KEYCLOAK_ADMIN_USER=setup
KEYCLOAK_ADMIN_PW=

# Geheimnis des Clients `ota-manager`. Bei "mitgeliefert" erzeugt und gesetzt,
# bei "vorhanden" von der fremden Verwaltung eingetragen.
OTA_KEYCLOAK_SECRET=

# Speicherdeckel für den mitgelieferten Keycloak. Auf einer
# Entwicklungsmaschine sinnvoll, damit er die Arbeitsplätze nicht verdrängt;
# produktiv gehört hier mehr hin oder gar nichts.
KEYCLOAK_JAVA_OPTS="-Xms256m -Xmx512m"

# Themenspeicher von Keycloak. `false` heisst: Aenderungen am Aussehen der
# Anmeldemaske wirken sofort. Fuer den Betrieb `true` lassen.
KEYCLOAK_THEME_CACHE=true
KEYCLOAK_THEME_MAX_AGE=2592000

# --- Vorgelagerter Reverse Proxy (optional) ---
#
# Steht vor OTA noch ein Proxy (Caddy, nginx, HAProxy), traegt er die
# urspruengliche Adresse in X-Forwarded-Host ein. Traefik **ersetzt** solche
# Kopfzeilen aber, solange der Absender nicht ausdruecklich als
# vertrauenswuerdig gilt — und dann fuehrt die Anmeldung an die interne
# Adresse statt an den Namen, unter dem der Browser hereinkam.
#
# Hier gehoert nur der eigene Proxy hinein; wer hier steht, darf behaupten,
# von wo eine Anfrage kommt. Leer heisst: niemandem glauben — die richtige
# Vorgabe, wenn OTA direkt erreichbar ist.
#
# Mehrere durch Komma getrennt, und dann **in Anfuehrungszeichen**:
#
#   OTA_TRUSTED_PROXIES="192.168.66.251/32,10.0.0.5/32"
#
# Diese Datei wird von Skripten eingelesen. Ein Leerzeichen ohne
# Anfuehrungszeichen macht aus dem Rest der Zeile einen Befehl — und das
# scheitert dann nicht laut, sondern still.
#
# **Die Adresse, unter der der Name aufloest, ist nicht unbedingt die, von der
# die Anfrage kommt.** Nachsehen statt raten:
#   curl -sk https://<name>/api/gibtsnicht -o /dev/null
#   docker logs ota-traefik --tail 5 | grep gibtsnicht
OTA_TRUSTED_PROXIES=

# --- Versuchsweg: Selkies statt KasmVNC -----------------------------------
#
# Eine Vorlage kann auf `stream_engine=selkies` stehen. Dann überträgt nicht
# KasmVNC das Bild, sondern Selkies — H.264 über WebRTC statt rechteckiger
# Ausschnitte über RFB. Das läuft noch im Versuch (`roadmap.md`).
#
# Der Medienstrom geht dabei **nicht durch Traefik**, sondern über einen
# TURN-Server im Session-Container. Hier steht die Adresse, unter der die
# Browser diesen Host erreichen — nicht die eines Docker-Netzes. Leer lassen,
# solange keine Vorlage auf Selkies steht.
OTA_SELKIES_TURN_HOST=
OTA_SELKIES_TURN_PORT=3478
OTA_SELKIES_TURN_MIN=65500
OTA_SELKIES_TURN_MAX=65510
